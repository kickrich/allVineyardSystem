# Локальная копия deploy-стека. Скопируйте в .env:
#   copy .env.local.example .env   (Windows)
#   cp .env.local.example .env     (Linux/macOS)

PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

POSTGRES_USER=vineyard_user
POSTGRES_PASSWORD=local_dev_postgres
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local_dev_minio
MINIO_BUCKET=vineyard-videos
MINIO_REGION=us-east-1
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# Локально можно оставить фиксированные ключи (только для dev!)
BACKEND_SECRET_KEY_BASE=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
VINEYARD_SECRET_KEY_BASE=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# CV: положите cvService/models/best.onnx и поставьте false
CV_DUMMY_INFERENCE=false
CV_USE_GPU=false
CV_FRAME_INTERVAL=4
CV_ENHANCE_FRAMES=true
CV_ORT_INTRA_THREADS=4
CV_ORT_INTER_THREADS=1
CV_UVICORN_WORKERS=1
CV_MAX_CONCURRENT_VIDEOS=1
CV_JOB_CONCURRENCY=1
CV_SERVICE_OPEN_TIMEOUT=60
CV_SERVICE_READ_TIMEOUT=14400

ENABLE_TEST_MISSION_VIDEO_SHARDS=true
VITE_USE_TEST_MISSION_SHARD_VIDEOS=true
BEHIND_SSL_PROXY=false
