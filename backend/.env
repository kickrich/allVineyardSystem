# S3 / MinIO — локальное хранилище видео
S3_BUCKET=vineyard-videos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# Папка с видео для автозагрузки (1 ряд = 1 файл row_1.mp4 или по порядку в папке)
LOCAL_VIDEOS_FOLDER=D:/Videos/mission
