# Реальные тестовые видео с backend (папка TEST_MISSION_SHARD_VIDEOS_DIR в backend/.env)
VITE_USE_TEST_MISSION_SHARD_VIDEOS=false

# Production (сборка frontend/Dockerfile или npm run build на VPS):
# Оставьте пустым, если API на том же домене через nginx (/api → backend)
VITE_API_BASE_URL=
VITE_API_DIRECT=true
