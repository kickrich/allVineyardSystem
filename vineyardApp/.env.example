CV_SERVICE_URL=http://localhost:8000
CV_SERVICE_OPEN_TIMEOUT=60
CV_SERVICE_READ_TIMEOUT=14400
# Каждый N-й кадр в CV (8 — баланс для 4 CPU; 4 — точнее, 12 — быстрее)
CV_FRAME_INTERVAL=8

# Очередь CV (production — см. .env.production.example)
# CV_JOB_CONCURRENCY=1
# JOB_CONCURRENCY=1

# URL vineyardApp для колбэка из CV (с хоста Docker: host.docker.internal:3000)
RAILS_URL=http://localhost:3000

BACKEND_URL=http://localhost:3001

# Цепочка с облака (backend → MinIO → этот Rails → CV): в backend задайте VINEYARD_APP_URL на этот хост/порт.

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vineyard-videos
MINIO_REGION=us-east-1

# PostgreSQL (локально)
DB_HOST=localhost
DB_NAME=vineyard_app
DB_USERNAME=vineyard_user
DB_PASSWORD=1029

# Production на VPS — см. корневой .env.production.example и DEPLOY.md
