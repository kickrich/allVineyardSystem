# Локальный запуск: скопируйте в .env (рядом с этим файлом).
# Без models/best.onnx сервис всё равно отвечает (заглушка, метрики = 0).
CV_DUMMY_INFERENCE=true
CV_STRICT_MODEL=0

# Скорость на CPU (VPS 4 ядра / 6 GB — значения по умолчанию в docker-compose.prod.yml)
# CV_FRAME_INTERVAL=4     # как preddeploy (4=точнее, 8–16=быстрее)
# CV_ENHANCE_FRAMES=true  # как preddeploy (false = без VineTrunkEnhancer)

# GPU (docker-compose.gpu.yml): enhance=off и interval=8 по умолчанию
# CV_USE_GPU=true
# CV_ENHANCE_FRAMES=false
# CV_GPU_IO_BINDING=true
# CV_SKIP_FRAME_DECODE=true
# CV_CUDA_CUDNN_CONV_ALGO=HEURISTIC

# Параллелизм CV (docker-compose.prod.yml):
# CV_UVICORN_WORKERS=1           # процессы uvicorn (держите 1)
# CV_MAX_CONCURRENT_VIDEOS=2     # видео одновременно (пул ONNX в cv)
# CV_JOB_CONCURRENCY=2           # vineyardApp: столько же parallel shard jobs
# Итого параллельных видео ≈ CV_UVICORN_WORKERS × CV_MAX_CONCURRENT_VIDEOS

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vineyard-videos
MINIO_REGION=us-east-1
MINIO_SECURE=false
