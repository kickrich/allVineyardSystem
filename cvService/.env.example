# Локальный запуск: скопируйте в .env (рядом с этим файлом).
# Без models/best.onnx сервис всё равно отвечает (заглушка, метрики = 0).
CV_DUMMY_INFERENCE=true
CV_STRICT_MODEL=0

# Скорость на CPU (VPS 4 ядра / 6 GB — значения по умолчанию в docker-compose.prod.yml)
# CV_FRAME_INTERVAL=8     # каждый N-й кадр (4=точнее, 12–16=быстрее)
# CV_ENHANCE_FRAMES=false # false = без VineTrunkEnhancer (быстрее)
# CV_ORT_INTRA_THREADS=4
# CV_ORT_INTER_THREADS=1

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vineyard-videos
MINIO_REGION=us-east-1
MINIO_SECURE=false
