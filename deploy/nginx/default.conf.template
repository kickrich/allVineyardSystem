# Docker DNS: без resolver nginx кеширует IP upstream при старте.
# После recreate backend/vineyard-app/frontend — 502, хотя контейнер healthy.
# ${MINIO_BUCKET} подставляется из env при старте контейнера nginx.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server;
    server_name _;

    client_max_body_size 2g;
    proxy_read_timeout 14400s;
    proxy_send_timeout 14400s;

    location = / {
        set $frontend http://frontend:80;
        proxy_pass $frontend/index.html;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        set $frontend http://frontend:80;
        proxy_pass $frontend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # MinIO S3 API: browser multipart PUT (presigned URL, same origin — CORS не нужен).
    location /${MINIO_BUCKET}/ {
        set $minio_upstream http://minio:9000;
        proxy_pass $minio_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 2g;
        proxy_read_timeout 14400s;
        proxy_send_timeout 14400s;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location /api/ {
        set $backend http://backend:80;
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /up {
        set $backend http://backend:80;
        proxy_pass $backend$request_uri;
        proxy_set_header Host $host;
    }

    location = /vineyard {
        return 301 $scheme://$host/vineyard/;
    }

    location ~ ^/video/(\d+)(/.*)?$ {
        return 301 $scheme://$host/vineyard/video/$1$2;
    }

    location ~ ^/vineyard(/.*)$ {
        set $vineyard http://vineyard-app:80$1$is_args$args;
        proxy_pass $vineyard;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        set $frontend http://frontend:80;
        proxy_pass $frontend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
