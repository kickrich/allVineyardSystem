# Скопируйте в .env на VPS и заполните значения:
#   cp .env.production.example .env

# Публичный URL сайта (для CORS). Примеры:
#   http://123.45.67.89
#   https://vineyard.example.com
PUBLIC_URL=http://YOUR_SERVER_IP

# Порт HTTP на хосте (443 — позже через certbot на хосте или отдельный compose override)
HTTP_PORT=80

# PostgreSQL
POSTGRES_USER=vineyard_user
POSTGRES_PASSWORD=change_me_strong_password

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET=vineyard-videos
MINIO_REGION=us-east-1
# Публичный URL MinIO, если нужен доступ снаружи (обычно не нужен)
S3_PUBLIC_ENDPOINT=http://minio:9000

# Сгенерировать: openssl rand -hex 64  (128 символов, НЕ master.key!)
BACKEND_SECRET_KEY_BASE=
VINEYARD_SECRET_KEY_BASE=

# Удалите из .env, если есть (вызывают ошибку "key must be 16 bytes"):
# RAILS_MASTER_KEY=
# BACKEND_RAILS_MASTER_KEY=
# VINEYARD_RAILS_MASTER_KEY=

# CV: true = заглушка без ONNX-весов; false = нужен cvService/models/best.onnx
CV_DUMMY_INFERENCE=true

# CV GPU (VPS с NVIDIA): true + nvidia-container-toolkit на хосте → Dockerfile.gpu
# deploy.sh подхватит docker-compose.gpu.yml автоматически
CV_USE_GPU=false
# CV_CUDA_DEVICE_ID=0

# CV: ускорение на VPS 4 CPU / 6 GB (больше interval = быстрее, меньше кадров)
CV_FRAME_INTERVAL=4
CV_ENHANCE_FRAMES=true
CV_ORT_INTRA_THREADS=4
CV_ORT_INTER_THREADS=1

# Параллелизм CV (на VPS 4 CPU / 6 GB лучше 1×1×1)
CV_UVICORN_WORKERS=1
CV_MAX_CONCURRENT_VIDEOS=1
CV_JOB_CONCURRENCY=1

# vineyard-app → cv: таймаут ожидания обработки шарда (секунды; 14400 = 4 ч)
CV_SERVICE_OPEN_TIMEOUT=60
CV_SERVICE_READ_TIMEOUT=14400

# Тестовые видео после миссии (test_mission_shard_videos/: mp4, webm, mov, avi, mkv по алфавиту = порядок рядов)
ENABLE_TEST_MISSION_VIDEO_SHARDS=true
VITE_USE_TEST_MISSION_SHARD_VIDEOS=true

# Включить после настройки HTTPS перед nginx (Let's Encrypt)
BEHIND_SSL_PROXY=false

# RAILS_LOG_LEVEL=info
