# Скопируйте в .env на VPS и заполните значения:
#   cp .env.production.example .env

# Публичный URL сайта (для CORS). Примеры:
#   http://123.45.67.89
#   https://vineyard.example.com
PUBLIC_URL=http://YOUR_SERVER_IP

# Порт HTTP на хосте (443 — позже через certbot на хосте или отдельный compose override)
HTTP_PORT=80

# PostgreSQL
POSTGRES_USER=vineyard_user
POSTGRES_PASSWORD=change_me_strong_password

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET=vineyard-videos
MINIO_REGION=us-east-1
# Публичный URL MinIO, если нужен доступ снаружи (обычно не нужен)
S3_PUBLIC_ENDPOINT=http://minio:9000

# Сгенерировать: openssl rand -hex 64  (128 символов, НЕ master.key!)
BACKEND_SECRET_KEY_BASE=
VINEYARD_SECRET_KEY_BASE=

# Удалите из .env, если есть (вызывают ошибку "key must be 16 bytes"):
# RAILS_MASTER_KEY=
# BACKEND_RAILS_MASTER_KEY=
# VINEYARD_RAILS_MASTER_KEY=

# CV: true = заглушка без ONNX-весов; false = нужен cvService/models/best.onnx
CV_DUMMY_INFERENCE=true

# Включить после настройки HTTPS перед nginx (Let's Encrypt)
BEHIND_SSL_PROXY=false

# RAILS_LOG_LEVEL=info
