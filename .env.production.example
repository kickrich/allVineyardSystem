# Скопируйте в .env на VPS и заполните значения:
#   cp .env.production.example .env

# Публичный URL сайта (для CORS). Примеры:
#   http://123.45.67.89
#   https://vineyard.example.com
PUBLIC_URL=http://YOUR_SERVER_IP

# Фронтенд: true — backend грузит local_videos/ в MinIO; false — браузер через multipart (presigned PUT)
VITE_VIDEO_FROM_FOLDER=false

# Порт HTTP на хосте
HTTP_PORT=80

# PostgreSQL
POSTGRES_USER=vineyard_user
POSTGRES_PASSWORD=change_me_strong_password

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET=vineyard-videos
MINIO_REGION=us-east-1
# Presigned URL для браузера (multipart). По умолчанию = PUBLIC_URL (не задавайте http://minio:9000).
# S3_PUBLIC_ENDPOINT=http://YOUR_SERVER_IP

# Сгенерировать: openssl rand -hex 64  (128 символов, НЕ master.key!)
BACKEND_SECRET_KEY_BASE=
VINEYARD_SECRET_KEY_BASE=

# Не используйте в Docker-деплое (вызывают ошибки):
# RAILS_MASTER_KEY=
# BACKEND_RAILS_MASTER_KEY=
# VINEYARD_RAILS_MASTER_KEY=

# CV: true = заглушка без ONNX-весов; false = нужен cvService/models/best.onnx
CV_DUMMY_INFERENCE=true

# CV GPU (VPS с NVIDIA): true + nvidia-container-toolkit → Dockerfile.gpu + docker-compose.gpu.yml
CV_USE_GPU=false

CV_FRAME_INTERVAL=6
CV_ENHANCE_FRAMES=false
CV_ORT_INTRA_THREADS=1
CV_ORT_INTER_THREADS=1
CV_GPU_IO_BINDING=false
CV_MAX_CONCURRENT_VIDEOS=1
CV_JOB_CONCURRENCY=1

# vineyard-app → cv: таймаут ожидания обработки шарда (секунды; 14400 = 4 ч)
CV_SERVICE_HTTP_TIMEOUT_SECONDS=14400

# Включить после настройки HTTPS перед nginx (Let's Encrypt)
BEHIND_SSL_PROXY=false

# RAILS_LOG_LEVEL=info
