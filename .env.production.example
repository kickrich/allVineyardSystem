# Скопируйте в .env на VPS и заполните значения:
#   cp .env.production.example .env

# Публичный URL сайта (для CORS). Примеры:
#   http://123.45.67.89
#   https://vineyard.example.com
PUBLIC_URL=http://YOUR_SERVER_IP

# Фронтенд: после миссии грузить видео из local_videos/ (не запись с canvas)
VITE_VIDEO_FROM_FOLDER=true

# Порт HTTP на хосте
HTTP_PORT=80

# PostgreSQL
POSTGRES_USER=vineyard_user
POSTGRES_PASSWORD=change_me_strong_password

# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET=vineyard-videos
MINIO_REGION=us-east-1
S3_PUBLIC_ENDPOINT=http://minio:9000

# Сгенерировать: openssl rand -hex 64  (128 символов, НЕ master.key!)
BACKEND_SECRET_KEY_BASE=
VINEYARD_SECRET_KEY_BASE=

# Не используйте в Docker-деплое (вызывают ошибки):
# RAILS_MASTER_KEY=
# BACKEND_RAILS_MASTER_KEY=
# VINEYARD_RAILS_MASTER_KEY=

# CV: положите cvService/models/best.onnx перед запуском
CV_USE_GPU=false

# vineyard-app → cv: таймаут ожидания обработки шарда (секунды)
CV_SERVICE_HTTP_TIMEOUT_SECONDS=14400

# Включить после настройки HTTPS перед nginx (Let's Encrypt)
BEHIND_SSL_PROXY=false

# RAILS_LOG_LEVEL=info
